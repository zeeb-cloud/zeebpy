# Copy to .env and fill in. The values shown are the defaults from settings.py.
# Booleans: 1/true/yes/on vs 0/false/no/off. Lists: comma-separated.
# An empty value means "explicitly empty", not "use the default".

# --- Core ------------------------------------------------------------------
DEBUG=true
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# --- Database --------------------------------------------------------------
# DATABASE_URL=sqlite+aiosqlite:///db.sqlite3
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/dbname
# ENFORCE_MIGRATIONS=true

# --- API -------------------------------------------------------------------
# API_TITLE=demo_blog API
# API_DESCRIPTION=
# API_VERSION=1.0.0
# API_PREFIX=/api/v1
# DEFAULT_LIMIT=20
# MAX_LIMIT=100

# --- CORS ------------------------------------------------------------------
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
# CORS_ALLOW_CREDENTIALS=true
# CORS_ALLOW_METHODS=*
# CORS_ALLOW_HEADERS=*
# CORS_EXPOSE_HEADERS=
# CORS_MAX_AGE=600

# --- Authentication --------------------------------------------------------
# JWT_SECRET_KEY=                    # defaults to SECRET_KEY
# JWT_ALGORITHM=HS256
# JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# JWT_ISSUER=
# JWT_AUDIENCE=
# AUTH_URL_PREFIX=/auth
# AUTH_ENABLE_REGISTRATION=true
# AUTH_LOGIN_THROTTLE_RATE=10/min    # empty turns it off
# AUTH_LOAD_USER_FROM_DB=true

# --- OAuth2 / OIDC   (pip install "zeebpy[oauth]") -------------------------
# Setting a client id activates that provider and mounts its routes.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=common
# OAUTH_AUTO_CREATE_USERS=true
# OAUTH_LINK_BY_EMAIL=true
# OAUTH_REQUIRE_VERIFIED_EMAIL=true
# OAUTH_STATE_TTL_SECONDS=600
# OAUTH_REDIRECT_URI=
# OAUTH_SUCCESS_REDIRECT=
# OAUTH_ALLOWED_REDIRECT_HOSTS=
# OAUTH_ACCEPT_EXTERNAL_TOKENS=

# --- Rate limiting ---------------------------------------------------------
# THROTTLE_ANON_RATE=120/min
# THROTTLE_USER_RATE=1200/min
# THROTTLE_NUM_PROXIES=0
# DEFAULT_THROTTLE_CLASSES=zeeb_api.throttling.AnonRateThrottle,zeeb_api.throttling.UserRateThrottle

# --- API versioning --------------------------------------------------------
# DEFAULT_VERSIONING_CLASS=zeeb_api.versioning.HeaderVersioning
# DEFAULT_VERSION=1.0
# ALLOWED_VERSIONS=1.0               # empty accepts any version
# VERSION_HEADER=X-API-Version
# VERSION_PARAM=version

# --- Logging ---------------------------------------------------------------
# LOG_LEVEL=INFO
# JSON_LOGS=false
# LOG_FILE=logs/app.log
# LOG_ROTATION=true
# LOG_RETENTION_DAYS=30
